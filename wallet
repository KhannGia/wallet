#!/usr/bin/env bash
#
# Task runner for the whole project. Everything executes inside Docker, so the
# host needs Docker and nothing else -- no Node, no npm, no Foundry, no make.
#
#   ./wallet help
#
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

DC=(docker compose)

# Runs a shell command in the Node toolchain container. --no-deps because
# installing or type-checking does not need Postgres or the chain running.
node_tools() { "${DC[@]}" run --rm --no-deps node-tools "$*"; }

# Runs a shell command in the Foundry container.
forge_run() { "${DC[@]}" run --rm forge "$*"; }

# Solidity dependencies, pinned. OpenZeppelin supplies the primitives that are
# dangerous to hand-roll in a contract holding reserves -- signature recovery
# with its malleability check, the EIP-712 domain, reentrancy protection -- and
# the tag is fixed so every machine compiles against the same audited code.
OZ_VERSION="5.7.0"
# The ERC-4337 EntryPoint, from the reference implementation. Pinned for good:
# the UserOperation layout and its hash differ between versions, and an account
# built for one cannot be used with another.
AA_VERSION="0.8.0"
FORGE_DEPS="set -e
    [ -d lib/forge-std/src ] || forge install --no-git foundry-rs/forge-std
    # Checked by version, not by presence: changing a pin above must actually
    # replace an older copy rather than leave it silently in place.
    if ! grep -q '\"version\": \"$OZ_VERSION\"' lib/openzeppelin-contracts/package.json 2>/dev/null; then
        rm -rf lib/openzeppelin-contracts
        forge install --no-git OpenZeppelin/openzeppelin-contracts@v$OZ_VERSION
    fi
    if ! grep -q '\"version\": \"$AA_VERSION\"' lib/account-abstraction/package.json 2>/dev/null; then
        rm -rf lib/account-abstraction
        forge install --no-git eth-infinitism/account-abstraction@v$AA_VERSION
    fi"

# Backend test files, optionally narrowed to one group. CI runs each group as
# its own job, in parallel; locally a group is a quicker check of one area.
#
# "core" is defined as everything the other groups do not claim, rather than
# as a list of its own, so a new test file always lands in some group. A list
# would let a file nobody added to it pass CI by never running at all.
CHAIN_TESTS='^services/api/src/chain/'
VAULT_TESTS='^services/api/src/vault/|^services/api/src/routes/vault\.test\.ts$'
AA_TESTS='^services/api/src/aa/'
backend_tests() {
    local all
    all=$(find packages/*/src services/*/src -name '*.test.ts' | sort)
    case "${1:-}" in
        "")    echo "$all" ;;
        chain) grep -E "$CHAIN_TESTS" <<<"$all" ;;
        vault) grep -E "$VAULT_TESTS" <<<"$all" ;;
        aa)    grep -E "$AA_TESTS" <<<"$all" ;;
        core)  grep -vE "$CHAIN_TESTS|$VAULT_TESTS|$AA_TESTS" <<<"$all" ;;
        *)
            echo "Unknown test group: $1 (expected core, chain, vault or aa)" >&2
            return 1
            ;;
    esac
}

# Runs the given backend test files. One at a time: the suites share a single
# database and a single chain, so two running at once would trip over each
# other's rows and nonces.
run_backend_tests() {
    local files
    files=$(backend_tests "${1:-}") || exit 1
    need_services
    # Only the smart-account tests talk to the bundler; the other groups skip
    # starting it, and the EntryPoint deployment it waits for. Recreated every
    # time: a restarted anvil has lost the EntryPoint and the bundler's own
    # contracts, while a bundler container left running would not notice.
    case "${1:-}" in
        ""|aa) "${DC[@]}" up -d --wait --force-recreate entrypoint-setup bundler ;;
    esac
    node_tools "node --test --test-concurrency=1 $(tr '\n' ' ' <<<"$files")"
}

# Brings up the backing services and waits until they report healthy.
need_services() { "${DC[@]}" up -d --wait postgres anvil; }

usage() {
    cat <<'EOF'
Usage: ./wallet <command>

Setup
  install         Install all dependencies (npm + Solidity) into Docker volumes
  install-node    Install npm workspace dependencies
  install-forge   Install Solidity dependencies

Runtime
  up              Start the full stack in the background
  dev             Start the stack and follow logs
  down            Stop the stack, keeping volumes
  restart         Restart the stack
  logs [service]  Follow logs
  ps              Show container status

Checks
  test            Run every test suite
  test-node [group]
                  Run backend tests (starts Postgres and anvil first);
                  group is core, chain, vault or aa, default all
  test-forge      Run Solidity tests
  coverage        Solidity coverage for contracts under src/
  typecheck       Type-check the whole workspace
  fmt             Format Solidity sources
  fmt-check       Verify Solidity formatting without writing

Wallet
  keygen          Generate an HD wallet offline (prints a mnemonic once)

Indexer
  deploy-token    Deploy the devnet ERC-20 and print its address (local only)
  indexer         Watch the chain and credit deposits (Ctrl+C to stop)
  withdrawer      Sign and broadcast payouts (holds the spending key)
  sweeper         Consolidate deposit addresses into the hot wallet

Vault
  vault-submitter Submit vault proposals that have reached their quorum

Smart accounts
  deploy-aa       Deploy the account factory and the paymaster (local only)
  paymaster       Serve gas sponsorships over ERC-7677 (holds the signer key)
  recovery-relayer
                  Start, execute and cancel guardian recoveries

Database
  migrate         Apply pending migrations
  db-reset        Drop the schema and re-apply every migration (destroys data)

Utilities
  psql            Open a psql shell against the dev database
  shell           Open a shell in the Node toolchain container
  forge <args>    Run an arbitrary forge command
  cast <args>     Run an arbitrary cast command against the local chain
  accounts        Show the deterministic anvil test accounts

Teardown
  clean           Stop and delete dependency volumes (database is kept)
  nuke            Stop and delete every volume, including the database
EOF
}

case "${1:-help}" in
    install)
        node_tools "npm install"
        forge_run "$FORGE_DEPS"
        ;;
    install-node)   node_tools "npm install" ;;
    install-forge)  forge_run "$FORGE_DEPS" ;;

    up)      "${DC[@]}" up -d --build --wait ;;
    dev)     "${DC[@]}" up -d --build --wait && "${DC[@]}" logs -f ;;
    down)    "${DC[@]}" down ;;
    restart) "${DC[@]}" down && "${DC[@]}" up -d --build --wait ;;
    logs)    shift; "${DC[@]}" logs -f "$@" ;;
    ps)      "${DC[@]}" ps ;;

    test)
        run_backend_tests
        forge_run "forge test -vv"
        ;;
    test-node)  run_backend_tests "${2:-}" ;;
    test-forge) forge_run "forge test -vv" ;;
    coverage)   forge_run "forge coverage --report summary --no-match-coverage '(test|script|mocks)/'" ;;
    typecheck)  node_tools "npm run typecheck" ;;

    deploy-token)
        # Devnet only. The key below is anvil's first account, printed in its
        # own banner; on a real network the wallet watches USDC and deploys
        # nothing.
        need_services
        "${DC[@]}" run --rm forge \
            "forge script script/DeployMockUsdc.s.sol:DeployMockUsdc --broadcast \
             --rpc-url http://anvil:8545 \
             --private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80" \
            | sed -n 's/^token: contract MockERC20 \(0x[0-9a-fA-F]*\)/USDC_ADDRESS=\1/p'
        ;;
    sweeper)
        need_services
        "${DC[@]}" run --rm node-tools "npm run sweeper --workspace @wallet/api"
        ;;
    deploy-aa)
        "${DC[@]}" up -d --wait bundler
        "${DC[@]}" run --rm -e PAYMASTER_SIGNER_PRIVATE_KEY forge "sh script/deploy-aa.sh"
        ;;
    paymaster)
        need_services
        "${DC[@]}" run --rm -p "${PAYMASTER_PORT:-4338}:${PAYMASTER_PORT:-4338}" node-tools \
            "npm run paymaster --workspace @wallet/api"
        ;;
    recovery-relayer)
        need_services
        "${DC[@]}" run --rm node-tools "npm run recovery-relayer --workspace @wallet/api"
        ;;
    vault-submitter)
        need_services
        "${DC[@]}" run --rm node-tools "npm run vault-submitter --workspace @wallet/api"
        ;;
    withdrawer)
        need_services
        "${DC[@]}" run --rm node-tools "npm run withdrawer --workspace @wallet/api"
        ;;
    indexer)
        need_services
        "${DC[@]}" run --rm --service-ports node-tools \
            "npm run indexer --workspace @wallet/api"
        ;;
    keygen)
        # Offline: generates a mnemonic and its xpub. Nothing is written to
        # disk, and no service needs to be running.
        node_tools "npm run keygen --workspace @wallet/api"
        ;;
    migrate)
        need_services
        node_tools "npm run migrate --workspace @wallet/api"
        ;;
    db-reset)
        # Drops the schema outright and rebuilds it. Development only: this
        # destroys every row, which is why it is a separate command from
        # migrate rather than a flag on it.
        need_services
        "${DC[@]}" exec -T postgres psql -U "${POSTGRES_USER:-wallet}" \
            -d "${POSTGRES_DB:-wallet}" -q \
            -c "DROP SCHEMA public CASCADE; CREATE SCHEMA public;"
        node_tools "npm run migrate --workspace @wallet/api"
        ;;
    fmt)        forge_run "forge fmt" ;;
    fmt-check)  forge_run "forge fmt --check" ;;

    psql)
        "${DC[@]}" exec postgres \
            psql -U "${POSTGRES_USER:-wallet}" -d "${POSTGRES_DB:-wallet}"
        ;;
    shell)
        "${DC[@]}" run --rm --no-deps --entrypoint /bin/bash node-tools
        ;;
    forge)
        shift; forge_run "forge $*"
        ;;
    cast)
        # No --rpc-url appended: the container sets ETH_RPC_URL, which cast
        # picks up on its own, so offline subcommands still work.
        shift; forge_run "cast $*"
        ;;
    accounts)
        "${DC[@]}" logs anvil | sed -n '/Available Accounts/,/Wallet/p'
        ;;

    clean)
        "${DC[@]}" down
        docker volume rm -f \
            wallet_node_modules_root wallet_node_modules_api \
            wallet_node_modules_shared wallet_forge_lib \
            wallet_forge_out wallet_forge_cache
        ;;
    nuke)
        "${DC[@]}" down -v
        ;;

    help|-h|--help) usage ;;
    *)
        echo "Unknown command: $1" >&2
        echo >&2
        usage >&2
        exit 1
        ;;
esac
