# The demo stack: ./wallet demo up runs the whole platform -- API, frontend and
# every worker -- as its own Compose project, beside the development stack and
# on its own ports, so neither touches the other's chain or database.
#
# Nothing secret here. Keys and contract addresses are generated on every run
# and written to .env.demo, which Compose reads after this file.

POSTGRES_PORT=5532
ANVIL_PORT=8645
BUNDLER_PORT=4437
API_PORT=3100
WEB_PORT=5273

# Faster than production, so a demo -- and the end-to-end tests -- see a
# deposit, a sweep and a payout settle in seconds rather than minutes.
FINALITY_MODE=confirmations
FINALITY_CONFIRMATIONS=2
INDEXER_POLL_MS=1000
WITHDRAWAL_POLL_MS=1000
SWEEP_POLL_MS=2000
MIN_SWEEP_BALANCE=1
VAULT_SUBMIT_POLL_MS=2000
RECOVERY_POLL_MS=2000
RESERVES_POLL_MS=20000
LOG_LEVEL=warn

# Every sponsored operation counts its worst case -- every gas limit at the
# highest fee it accepts -- against an account's daily cap. A demo account
# deploys, names guardians, grants sessions and sends within minutes, which
# the production default of 0.01 ether would refuse before long.
PAYMASTER_DAILY_GAS_CAP_WEI=100000000000000000
