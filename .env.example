# Copy to .env and adjust. .env is gitignored and must never hold a real key.
#
# NOTE: every value here is a local development default. Production key material
# belongs in a KMS or HSM, never in a file on disk.

# --- Postgres ---
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_DB=wallet
POSTGRES_PORT=5432

# --- Local chain ---
ANVIL_PORT=8545

# --- API ---
API_PORT=3000
LOG_LEVEL=info

# --- HD wallet ---
# Extended PUBLIC key at m/44'/60'/0'/0. The server derives every deposit
# address from this and cannot spend what arrives.
#
# The default below belongs to the well-known public Foundry test mnemonic and
# controls nothing. Generate your own with: ./wallet keygen
WALLET_XPUB=xpub6DyUKdwoLWmUJ4Tn9Bbsdtx7B5Ws18mEN19e5HT52ikE53FiUheSQXrZUNPovqfyKmw4579A1Mm3GXXKM39N64uooBfJ4tNAzFsEbodRTx4

# --- Indexer ---
# The ERC-20 the indexer watches. On a real network this is USDC; locally,
# deploy the devnet token with `./wallet deploy-token` and paste the result.
USDC_ADDRESS=

# Where a fresh indexer starts. Never "the current block": that silently skips
# every deposit that arrived while it was down.
INDEXER_START_BLOCK=0

# `finalized` is correct on a real network. anvil has no consensus layer and
# pins its finalized tag to genesis forever, so a devnet must count
# confirmations instead or nothing would ever be credited.
FINALITY_MODE=confirmations
FINALITY_CONFIRMATIONS=3
INDEXER_POLL_MS=4000

# --- Withdrawal worker ---
# The ONLY component that can move funds. Development only: in production this
# belongs in a KMS or HSM. Generate a throwaway devnet key with:
#   ./wallet cast wallet new
# Never put a key here that holds anything of value, and never commit it.
HOT_WALLET_PRIVATE_KEY=

# A transaction unmined for this long is resent at a higher fee. One stuck
# transaction blocks every later nonce behind it, so this must not be generous.
STUCK_AFTER_MS=60000
FEE_BUMP_PERCENT=12
WITHDRAWAL_POLL_MS=4000

# --- Sweeper ---
# The phrase WALLET_XPUB was derived from. It can spend every deposit address,
# so it belongs in a KMS in production and never in a file. A mismatch with
# WALLET_XPUB is caught before anything is signed.
WALLET_MNEMONIC=

# Below this token balance an address is left alone: an ERC-20 transfer costs
# the same gas whether it moves a million tokens or five.
MIN_SWEEP_BALANCE=1000000

# Pays that gas. Its own throwaway devnet key, NOT HOT_WALLET_PRIVATE_KEY: the
# withdrawal worker allocates the hot wallet's nonces, and a second sender would
# take nonces payouts were promised. Keep it topped up with native currency;
# the sweeper warns when fewer than ten fundings remain.
GAS_FUNDER_PRIVATE_KEY=

# Native currency sent to an address that cannot pay for its own transfer.
SWEEP_GAS_FUNDING_WEI=2000000000000000
SWEEP_POLL_MS=15000

# --- Vault ---
# The multisig holding cold reserves. Without it the proposal API answers 503.
VAULT_ADDRESS=

# Pays gas to submit proposals that have their quorum. It authorises nothing --
# the owners' signatures do -- but it must NOT be HOT_WALLET_PRIVATE_KEY: the
# withdrawal worker allocates that account's nonces, and a second sender would
# collide with them. Generate a separate throwaway devnet key.
VAULT_SUBMITTER_PRIVATE_KEY=
VAULT_SUBMIT_POLL_MS=5000

# --- Rebalancing (all three marks, or none to switch it off) ---
# Token minor units of the hot wallet's AVAILABLE balance: on-chain balance
# minus payouts already reserved. Below LOW the vault submitter proposes a
# top-up for owners to sign; above HIGH the withdrawal worker returns the
# excess to the vault. Both bring the balance back to TARGET.
# Example for 6-decimal USDC: 1,000 / 5,000 / 20,000 USDC.
REBALANCE_LOW=
REBALANCE_TARGET=
REBALANCE_HIGH=
# How long owners have to sign an automatic top-up.
REBALANCE_PROPOSAL_TTL_SECONDS=86400
